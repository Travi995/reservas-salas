# Base de datos (también la lee docker compose: `pnpm db:up`)
DB_HOST=localhost
DB_PORT=5440
DB_USER=reservas
DB_PASSWORD=reservas
DB_NAME=reservas

# API
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Autenticación (Bearer JWT)
# Secreto para firmar los tokens: genera uno propio, p. ej. `openssl rand -base64 48`.
JWT_SECRET=cambia-este-secreto
# Caducidad del token (formato de `ms`: 8h, 30m, 7d…)
JWT_EXPIRES_IN=8h
