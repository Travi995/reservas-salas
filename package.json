{
  "name": "reservas-salas",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "bootstrap": "node scripts/setup.mjs && pnpm install && pnpm db:up && pnpm seed",
    "dev": "pnpm db:up && pnpm --parallel --filter @reservas/api --filter @reservas/web dev",
    "db:up": "docker compose --env-file apps/api/.env up -d --wait",
    "db:down": "docker compose --env-file apps/api/.env down",
    "seed": "pnpm --filter @reservas/api seed",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @reservas/api test:e2e",
    "lint": "pnpm -r lint"
  }
}
