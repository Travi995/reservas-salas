# Database (also read by docker compose: `pnpm db:up`)
DB_HOST=localhost
DB_PORT=5440
DB_USER=reservas
DB_PASSWORD=reservas
DB_NAME=reservas

# API
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Authentication (Bearer JWT)
# Secret used to sign the tokens: generate your own, e.g. `openssl rand -base64 48`.
JWT_SECRET=cambia-este-secreto
# Token expiry (`ms` format: 8h, 30m, 7d…)
JWT_EXPIRES_IN=8h

# Login + register attempts allowed per IP per minute
AUTH_RATE_LIMIT=10

# Logs: `pretty` (readable) or `json` (one JSON object per line, for log collectors)
LOG_FORMAT=pretty
